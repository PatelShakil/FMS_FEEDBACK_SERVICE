# ============================================
# FEEDBACK SERVICE CONFIGURATION
# ============================================

# Service
NODE_ENV=development
PORT=8088
SERVICE_NAME=feedback-service

# MongoDB
MONGODB_URI=mongodb://boloindia:boloindiapass@localhost:27017/feedback_db?authSource=admin
MONGODB_DB_NAME=feedback_db
MONGODB_POOL_SIZE=10

# JWT Authentication
JWT_PUBLIC_KEY_PATH=/keys/publicKey.pem
JWT_ALGORITHM=RS256

# Kafka
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=feedback-service
KAFKA_GROUP_ID=feedback-service-group
KAFKA_ENABLE=true

# MinIO
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=boloindia
MINIO_SECRET_KEY=boloindiapass123
MINIO_BUCKET_FORMS=feedback-forms
MINIO_BUCKET_TEMPLATES=form-templates

# Logging
LOG_LEVEL=debug
LOG_FILE_PATH=./logs

# CORS
CORS_ORIGIN=*

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Pagination
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100
